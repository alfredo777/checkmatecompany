{{!-- Portada (textos: contents/i18n.json · contenido: catalogo(-en).json y partida-opera(-en).json) --}}
{{> icons}}
{{> chess-defs}}
{{> site-nav}}

<main id="contenido">

<!-- ══════════════════════════════════════════════
     ██  HERO
     ══════════════════════════════════════════════ -->
<section class="hero" id="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="hero-badge reveal">
        <span class="hero-badge-dot" aria-hidden="true"></span>
        {{t.badge}}
      </p>
      <h1 class="reveal">
        {{t.h1a}}<br>
        <span class="gold-text">{{t.h1b}}</span>
      </h1>
      <p class="hero-sub reveal">{{catalogo.marca.descripcion}}</p>
      <div class="hero-actions reveal">
        <a href="{{base}}/hyper-clock" class="btn-primary">{{t.ctaProduct}} <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
        <a href="#partida" class="btn-secondary"><svg class="icon" aria-hidden="true"><use href="#i-play"/></svg> {{t.ctaGame}}</a>
      </div>
    </div>

    <figure class="hero-board reveal">
      <svg id="heroBoard" viewBox="0 0 360 360" role="img" aria-labelledby="heroBoardTitle">
        <title id="heroBoardTitle">{{t.heroBoardTitle}}</title>
        <rect width="360" height="360" fill="url(#sq)"/>
        <rect data-mark="from" class="mark" width="45" height="45"/>
        <rect data-mark="to" class="mark" width="45" height="45"/>
        <rect data-mark="check" class="mark-check" width="45" height="45" fill="url(#checkGlow)"/>
        <g data-layer="pieces"></g>
      </svg>
      <figcaption aria-hidden="true"><span class="hb-label">{{t.heroBoardLabel}}</span><span id="heroBoardMove" class="hb-move">{{t.heroBoardLabel}}</span></figcaption>
    </figure>
  </div>
</section>

<!-- ══════════════════════════════════════════════
     ██  HYPER CLOCK
     ══════════════════════════════════════════════ -->
<section class="section-pad" id="hyper-clock" aria-labelledby="hc-title">
  <div class="container">
    <h2 class="section-title reveal" id="hc-title">{{t.hcTitleA}} <span class="gold-text">Hyper Clock</span></h2>
    <p class="section-desc reveal">{{t.hcDesc}}</p>

    {{#each catalogo.apps}}
    <article class="app-card reveal">
      <div class="app-media">
        <img src="{{this.imagen}}" alt="{{@root.t.iconAlt}} {{this.nombre}}" width="160" height="160" loading="lazy" decoding="async">
      </div>
      <div class="app-body">
        <p class="app-type">{{this.tipo}}</p>
        <h3>{{this.nombre}}</h3>
        {{#if this.lema}}<p class="app-tagline" lang="en">{{this.lema}}</p>{{/if}}
        <p>{{this.descripcion}}</p>
        <ul class="app-features">
          {{#each this.funciones}}<li>{{this}}</li>{{/each}}
        </ul>
        <div class="app-actions">
          {{#if this.ios}}<a href="{{this.ios}}" class="btn-primary" target="_blank" rel="noopener">{{@root.t.downloadIos}}</a>{{/if}}
          {{#if this.android}}<a href="{{this.android}}" class="btn-primary" target="_blank" rel="noopener">{{@root.t.downloadAndroid}}</a>{{/if}}
          <a href="{{@root.base}}/hyper-clock" class="btn-primary">{{@root.t.seeShots}} <svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
          {{#unless this.ios}}{{#unless this.android}}
          <a href="{{waLink @root.catalogo.marca.whatsapp @root.t.notifyMsg this.nombre '.'}}" class="btn-secondary" target="_blank" rel="noopener"><svg class="icon" aria-hidden="true"><use href="#i-bell"/></svg> {{@root.t.notify}}</a>
          {{/unless}}{{/unless}}
        </div>
        {{#unless this.ios}}{{#unless this.android}}<p class="app-status">{{this.estado}}</p>{{/unless}}{{/unless}}
      </div>
    </article>

    <ul class="shots reveal" role="list" aria-label="{{@root.t.shotsAria}} {{this.nombre}}">
      {{#each this.capturas}}
      {{#if this.portada}}
      <li class="shot">
        <img src="{{asset this.src}}" alt="{{this.alt}}" width="720" height="1513" loading="lazy" decoding="async">
      </li>
      {{/if}}
      {{/each}}
    </ul>
    {{/each}}
  </div>
</section>

{{> partida}}

<!-- ══════════════════════════════════════════════
     ██  CONTACTO
     ══════════════════════════════════════════════ -->
<section class="section-pad quote-section" id="contacto" aria-labelledby="contacto-title">
  <div class="container">
    <div class="quote-wrap">
      <div class="quote-left">
        <h2 class="reveal" id="contacto-title">{{t.contactTitleA}} <span class="gold-text">{{t.contactTitleB}}</span></h2>
        <p class="reveal">{{t.contactDesc}}</p>
        <ul class="quote-features" role="list">
          <li class="qf-item reveal">
            <div class="qf-icon"><svg class="icon" aria-hidden="true"><use href="#i-chat"/></svg></div>
            <div>
              <h3>{{t.contactWa}}</h3>
              <p><a href="{{waLink catalogo.marca.whatsapp}}" target="_blank" rel="noopener">{{catalogo.marca.whatsappVisible}}</a></p>
            </div>
          </li>
          <li class="qf-item reveal">
            <div class="qf-icon"><svg class="icon" aria-hidden="true"><use href="#i-mail"/></svg></div>
            <div>
              <h3>{{t.contactEmail}}</h3>
              <p><a href="mailto:{{catalogo.marca.email}}">{{catalogo.marca.email}}</a></p>
            </div>
          </li>
          <li class="qf-item reveal">
            <div class="qf-icon"><svg class="icon" aria-hidden="true"><use href="#i-bell"/></svg></div>
            <div>
              <h3>{{t.contactLaunch}}</h3>
              <p>{{t.contactLaunchText}}</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="quote-form-card reveal">
        <div class="qf-header">
          <h3>{{t.writeUs}}</h3>
          <p>{{t.formHint}}</p>
        </div>
        <form id="contactForm" novalidate data-wa="{{catalogo.marca.whatsapp}}">
          <div class="form-group">
            <label for="cName">{{t.formName}}</label>
            <input type="text" id="cName" name="name" placeholder="{{t.formNamePh}}" required minlength="2" autocomplete="name" autocapitalize="words" enterkeyhint="next" aria-describedby="cNameError">
            <p class="field-error" id="cNameError" aria-live="polite"></p>
          </div>
          <div class="form-group">
            <label for="cInterest">{{t.formInterest}} <span class="optional">{{t.formOptional}}</span></label>
            <select id="cInterest" name="interest">
              <option value="">{{t.formChoose}}</option>
              {{#each catalogo.apps}}<option>{{@root.t.formOptNotify}} {{this.nombre}}</option>{{/each}}
              <option>{{t.formOptIdea}}</option>
              <option>{{t.formOptOther}}</option>
            </select>
          </div>
          <div class="form-group">
            <label for="cMessage">{{t.formMessage}} <span class="optional">{{t.formOptional}}</span></label>
            <textarea id="cMessage" name="message" rows="4" placeholder="{{t.formMessagePh}}" enterkeyhint="send"></textarea>
          </div>
          <div class="form-nav">
            <button type="submit" class="btn-primary"><svg class="icon" aria-hidden="true"><use href="#i-chat"/></svg> {{t.formSend}}</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

</main>

{{> site-footer}}
{{> wa-fab}}

<script src="{{asset '/assets/js/board.js'}}" defer></script>
