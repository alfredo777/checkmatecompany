<!DOCTYPE html>
<html lang="{{#if lang}}{{lang}}{{else}}es{{/if}}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="dark">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- ═══════════════════════════════════════════
    ██  SEO / META
    ═══════════════════════════════════════════ -->
    <title>{{#if title}}{{title}} — CheckMate Company{{else}}CheckMate Company — Productos de ajedrez locales y digitales{{/if}}</title>
    <meta name="description" content="{{#if metaDescription}}{{metaDescription}}{{else}}CheckMate Company hace productos de ajedrez para jugar mejor sobre un tablero de verdad. El primero es Hyper Clock: el reloj de ajedrez que registra tu partida.{{/if}}">
    <meta name="keywords" content="{{#if metaKeywords}}{{metaKeywords}}{{else}}ajedrez, chess, reloj de ajedrez, chess clock, Hyper Clock, notación de ajedrez, México{{/if}}">
    <meta name="author" content="CheckMate Company">
    <meta name="robots" content="{{#if noIndex}}noindex, nofollow{{else}}index, follow{{/if}}">
    <link rel="canonical" href="{{#if canonicalUrl}}{{canonicalUrl}}{{else}}{{currentUrl}}{{/if}}">
    <meta name="version" content="{{appVersion}}">
    <!-- ═══════════════════════════════════════════
    ██  OPEN GRAPH / SOCIAL
    ═══════════════════════════════════════════ -->
    <meta property="og:type" content="{{#if ogType}}{{ogType}}{{else}}website{{/if}}">
    <meta property="og:title" content="{{#if ogTitle}}{{ogTitle}}{{else}}{{#if title}}{{title}} — CheckMate Company{{else}}CheckMate Company — Ajedrez local y digital{{/if}}{{/if}}">
    <meta property="og:description" content="{{#if ogDescription}}{{ogDescription}}{{else}}{{#if metaDescription}}{{metaDescription}}{{else}}Cada movimiento cuenta. Hyper Clock, el reloj de ajedrez que registra tu partida.{{/if}}{{/if}}">
    <meta property="og:url" content="{{#if canonicalUrl}}{{canonicalUrl}}{{else}}{{currentUrl}}{{/if}}">
    <meta property="og:site_name" content="CheckMate Company">
    <meta property="og:locale" content="{{#if ogLocale}}{{ogLocale}}{{else}}es_MX{{/if}}">
    {{#if urlEn}}
    <link rel="alternate" hreflang="es" href="{{urlEs}}">
    <link rel="alternate" hreflang="en" href="{{urlEn}}">
    <link rel="alternate" hreflang="x-default" href="{{urlEs}}">
    {{/if}}
    {{#if ogImage}}
    <meta property="og:image" content="{{ogImage}}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    {{else}}
    <meta property="og:image" content="{{baseUrl}}{{asset '/assets/images/logo-stacked-nolema.png'}}">
    {{/if}}
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{#if title}}{{title}} — CheckMate Company{{else}}CheckMate Company — Ajedrez local y digital{{/if}}">
    <meta name="twitter:description" content="{{#if metaDescription}}{{metaDescription}}{{else}}Cada movimiento cuenta. Hyper Clock, el reloj de ajedrez que registra tu partida.{{/if}}">
    {{#if ogImage}}
    <meta name="twitter:image" content="{{ogImage}}">
    {{else}}
    <meta name="twitter:image" content="{{baseUrl}}{{asset '/assets/images/logo-stacked-nolema.png'}}">
    {{/if}}
    <!-- ═══════════════════════════════════════════
    ██  THEME / PWA
    ═══════════════════════════════════════════ -->
    <meta name="theme-color" content="#06060b">
    <meta name="msapplication-TileColor" content="#06060b">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="CheckMate">
    <!-- Favicons -->
    <link rel="icon" type="image/png" href="{{asset '/assets/images/icon.png'}}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{asset '/assets/images/icon.png'}}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{asset '/assets/images/icon.png'}}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{asset '/assets/images/icon.png'}}">
    <link rel="manifest" href="{{asset '/assets/manifest.json'}}">
    <!-- ═══════════════════════════════════════════
    ██  PRELOADS (Critical Resources)
    ═══════════════════════════════════════════ -->
    <!-- Fuentes críticas -->
    <link rel="preload" href="/assets/fonts/playfair-800.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/assets/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin>
    {{{css "/assets/css/main.css" "style"}}}
  </head>
  <body>
    {{{body}}}
    {{{js "/assets/js/main.js" "script"}}}
  </body>
</html>